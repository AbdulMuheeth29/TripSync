# Staging Environment Configuration
# Copy this file and fill in your staging values

NODE_ENV=staging
PORT=3000

# Database (Staging)
POSTGRES_PASSWORD_STAGING=staging_password_change_me
DATABASE_URL=postgresql://tripsync_staging:staging_password_change_me@localhost:5433/tripsync_staging

# Redis (Staging)
REDIS_URL=redis://localhost:6380

# Authentication (REQUIRED - generate with: npm run generate-secrets)
JWT_SECRET=your-staging-jwt-secret-min-32-chars

# Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-staging-vapid-public-key
VAPID_PRIVATE_KEY=your-staging-vapid-private-key

# Email (Use test email service or Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-staging-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=staging-noreply@tripsync.app

# Admin
ADMIN_EMAILS=abdulmuheethmd29@gmail.com

# Optional Services (for staging testing)
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
SENTRY_DSN=https://...@sentry.io/...
STRIPE_SECRET_KEY=sk_test_...

# App URL
APP_URL=http://localhost:3001

# Feature Flags (Emergency Disable)
FEATURE_AI_ENABLED=true
FEATURE_FILE_UPLOADS_ENABLED=true
FEATURE_STRIPE_ENABLED=true
FEATURE_CHAT_ENABLED=true
FEATURE_PUSH_ENABLED=true
