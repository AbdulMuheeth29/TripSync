# ============ Required (production) ============
# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database (REQUIRED in production)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/tripsync

# Authentication (REQUIRED)
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# VAPID Keys for Push Notifications (Recommended in production)
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ============ Optional ============
# AI Features (Anthropic)
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Admin Access (comma-separated emails for /admin/metrics)
# ADMIN_EMAILS=admin@example.com,admin2@example.com

# CORS (when serving API separately from frontend)
# CORS_ORIGIN=https://yourdomain.com

# App URL (for Stripe redirects, emails, etc.)
# APP_URL=https://tripsync.app

# Stripe (pricing disabled when unset)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_TEAMS_MONTHLY=price_...
# STRIPE_PRICE_TEAMS_ANNUAL=price_...

# Email (SMTP) - REQUIRED for password reset and trip invites
# See docs/EMAIL-CONFIGURATION.md for setup instructions
#
# Gmail (for testing):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your-email@gmail.com
#
# SendGrid (recommended for production):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your-api-key-here
# SMTP_FROM=noreply@yourdomain.com
#
# AWS SES (best for high volume):
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@yourdomain.com
#
# Contact form submissions go to this address (optional; requires SMTP)
# CONTACT_EMAIL=support@tripsync.app

# File Storage (AWS S3 or Cloudflare R2)
# Choose one: AWS S3 OR Cloudflare R2 (R2 is more cost-effective)
#
# Option 1: AWS S3
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=tripsync-uploads
# AWS_REGION=us-east-1
#
# Option 2: Cloudflare R2 (S3-compatible, cheaper)
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=tripsync-uploads
# R2_PUBLIC_URL=https://uploads.yourdomain.com  # Optional: custom domain

# Database Backups (AWS S3)
# BACKUP_DIR=./backups
# AWS_S3_BACKUP_BUCKET=tripsync-backups-production

# Error Monitoring (Recommended in production)
# Get your DSN from https://sentry.io
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Analytics (Recommended for production)
# Choose one: PostHog (recommended) OR Google Analytics
#
# Option 1: PostHog (recommended - better privacy, more features, free tier)
# Sign up at: https://posthog.com
# VITE_POSTHOG_KEY=phc_your_project_api_key
# VITE_POSTHOG_HOST=https://app.posthog.com
#
# Option 2: Google Analytics (simple, widely used)
# Get tracking ID from: https://analytics.google.com
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Redis Caching (Optional but recommended for production)
# Used for: token blacklist, session revocation, caching frequently accessed data
# If not provided, falls back to in-memory storage
# REDIS_URL=redis://localhost:6379
# For Redis Cloud: redis://username:password@host:port
# For Upstash: rediss://username:password@host:port

# CDN for Static Assets (Optional)
# Serve /assets/ from a CDN for better performance
# Leave empty to serve from local server
# VITE_CDN_URL=https://cdn.yoursite.com

# ============ Feature Flags (Emergency Disable) ============
# Set to false to disable features without redeployment
# All features are enabled by default (true)
FEATURE_AI_ENABLED=true
FEATURE_FILE_UPLOADS_ENABLED=true
FEATURE_STRIPE_ENABLED=true
FEATURE_CHAT_ENABLED=true
FEATURE_PUSH_ENABLED=true
